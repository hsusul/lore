{
  "description": "Lore memory notes for the repository at session start, for each prompt, and before an edit, and a deny for a tool call an accepted note's rule matches.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "lorectl hook session-start", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "lorectl hook prompt", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          { "type": "command", "command": "lorectl hook pre-tool", "timeout": 5 }
        ]
      }
    ]
  }
}
