{
  "description": "Lore memory notes for the repository at session start, for each prompt, and before an edit.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "lorectl hook session-start", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "lorectl hook prompt", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          { "type": "command", "command": "lorectl hook pre-edit", "timeout": 5 }
        ]
      }
    ]
  }
}
